# Runtime
KQUANT_CRYPTO_MODE=development
KQUANT_CRYPTO_HOST=127.0.0.1
KQUANT_CRYPTO_PORT=8010
KQUANT_CRYPTO_CORE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,TRXUSDT,LTCUSDT,BCHUSDT,UNIUSDT,AAVEUSDT,NEARUSDT,ATOMUSDT,SUIUSDT,INJUSDT,SEIUSDT,APTUSDT,ARBUSDT,OPUSDT,TIAUSDT,DOGEUSDT,SHIBUSDT,PEPEUSDT,WIFUSDT,BONKUSDT,FLOKIUSDT
KQUANT_CRYPTO_DB_PATH=work/kquant_crypto.sqlite3
KQUANT_CRYPTO_DATA_DIR=data
KQUANT_CRYPTO_OUTPUTS_DIR=outputs

# Local single-user login. Generate values with the CLI commands in README.md.
KQUANT_CRYPTO_LOGIN_EMAIL=
KQUANT_CRYPTO_LOGIN_PASSWORD_HASH=
KQUANT_CRYPTO_SESSION_SECRET=
KQUANT_CRYPTO_SESSION_IDLE_MINUTES=30
KQUANT_CRYPTO_SESSION_MAX_HOURS=8

# Public market-data providers. They remain disabled during Week 1.
KQUANT_CRYPTO_ENABLE_BINANCE=false
KQUANT_CRYPTO_ENABLE_OKX=false
KQUANT_CRYPTO_ENABLE_COINBASE=false
KQUANT_CRYPTO_ENABLE_KRAKEN=false
KQUANT_CRYPTO_ENABLE_DEXSCREENER=false
KQUANT_CRYPTO_ENABLE_GOPLUS=false
KQUANT_CRYPTO_ENABLE_BIRDEYE=false
KQUANT_CRYPTO_ENABLE_COINGLASS=false

# Optional data keys. Never commit real values.
BIRDEYE_API_KEY=
COINGLASS_API_KEY=
GOPLUS_API_KEY=

# Notifications are opt-in and disabled by default.
KQUANT_CRYPTO_ENABLE_NOTIFICATIONS=false
KQUANT_CRYPTO_ENABLE_TELEGRAM=false
KQUANT_CRYPTO_WEB_PUSH_PUBLIC_KEY=
KQUANT_CRYPTO_WEB_PUSH_PRIVATE_KEY=
KQUANT_CRYPTO_WEB_PUSH_SUBJECT=mailto:you@example.com
KQUANT_CRYPTO_TELEGRAM_BOT_TOKEN=
KQUANT_CRYPTO_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KQUANT_CRYPTO_VAPID_PUBLIC_KEY=
KQUANT_CRYPTO_VAPID_PRIVATE_KEY=
KQUANT_CRYPTO_VAPID_SUBJECT=mailto:local@kquant.invalid
