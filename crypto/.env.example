# Runtime
KQUANT_CRYPTO_MODE=development
KQUANT_CRYPTO_HOST=127.0.0.1
KQUANT_CRYPTO_PORT=8010
KQUANT_CRYPTO_CORE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,TRXUSDT,LTCUSDT,BCHUSDT,UNIUSDT,AAVEUSDT,NEARUSDT,ATOMUSDT,ZECUSDT,SUIUSDT,INJUSDT,SEIUSDT,APTUSDT,ARBUSDT,OPUSDT,TIAUSDT,DOGEUSDT,SHIBUSDT,PEPEUSDT,WIFUSDT,BONKUSDT,FLOKIUSDT,PUMPUSDT
KQUANT_CRYPTO_DB_PATH=work/kquant_crypto.sqlite3
KQUANT_CRYPTO_DATA_DIR=data
KQUANT_CRYPTO_OUTPUTS_DIR=outputs
# Raw archive policy: trades are persisted as bounded summaries; quotes are
# persisted at a controlled cadence while every event remains in memory.
KQUANT_CRYPTO_TRADE_BUCKET_SECONDS=60
KQUANT_CRYPTO_QUOTE_SAMPLE_SECONDS=5
KQUANT_CRYPTO_TICKER_SAMPLE_SECONDS=10
# Trade/BBO/mark-price streams are limited to core high-frequency symbols;
# all configured symbols still receive ticker and 1m K-line streams.
KQUANT_CRYPTO_HIGH_FREQUENCY_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
KQUANT_CRYPTO_STORAGE_FLUSH_EVERY=5000

# Local single-user login. Generate values with the CLI commands in README.md.
KQUANT_CRYPTO_LOGIN_EMAIL=
KQUANT_CRYPTO_LOGIN_PASSWORD_HASH=
KQUANT_CRYPTO_SESSION_SECRET=
KQUANT_CRYPTO_SESSION_IDLE_MINUTES=30
KQUANT_CRYPTO_SESSION_MAX_HOURS=8
# Local preview is enabled only for development on loopback when login is not configured.
KQUANT_CRYPTO_LOCAL_PREVIEW=true

# Unified workspace BFF. Keep this token local and allow the gateway to call
# the crypto runtime only from loopback; it is never sent to the browser.
KQUANT_CRYPTO_INTERNAL_API_TOKEN=

# Public market-data providers. Keep them disabled until permissions and
# source coverage have been verified.
KQUANT_CRYPTO_ENABLE_BINANCE=false
KQUANT_CRYPTO_ENABLE_OKX=false
KQUANT_CRYPTO_ENABLE_COINBASE=false
KQUANT_CRYPTO_ENABLE_KRAKEN=false
KQUANT_CRYPTO_ENABLE_DEXSCREENER=false
KQUANT_CRYPTO_ENABLE_GOPLUS=false
KQUANT_CRYPTO_ENABLE_BIRDEYE=false
KQUANT_CRYPTO_ENABLE_COINGLASS=false
KQUANT_CRYPTO_ENABLE_DEFILLAMA=false

# Binance public market-data endpoints. These URLs never carry API keys,
# account requests, user streams, or orders.
BINANCE_SPOT_MARKET_DATA_BASE_URL=https://data-api.binance.vision
BINANCE_SPOT_MARKET_DATA_STREAM_URL=wss://data-stream.binance.vision/stream
BINANCE_FUTURES_MARKET_DATA_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_MARKET_DATA_STREAM_URL=wss://fstream.binance.com/stream

# Optional data keys. Never commit real values.
BIRDEYE_API_KEY=
COINGLASS_API_KEY=
GOPLUS_API_KEY=
# Optional point-in-time evidence feeds. The app records source metadata and
# keeps missing values as N/A; it never invents ETF or on-chain metrics.
KQUANT_CRYPTO_ETF_EVIDENCE_URL=
KQUANT_CRYPTO_ONCHAIN_EVIDENCE_URL=
KQUANT_CRYPTO_STAGING_DATABASE_URL=

# Unified read-only Stocks/Crypto workspace gateway.
KQUANT_GATEWAY_STOCKS_URL=http://127.0.0.1:8001
KQUANT_GATEWAY_CRYPTO_URL=http://127.0.0.1:8010
KQUANT_GATEWAY_PORT=8020
KQUANT_GATEWAY_WEB_DIST=../web/dist-unified
KQUANT_WORKSPACE_LOGIN_ENABLED=false
KQUANT_WORKSPACE_LOGIN_EMAIL=
KQUANT_WORKSPACE_LOGIN_PASSWORD_HASH=
KQUANT_WORKSPACE_SESSION_SECRET=
KQUANT_WORKSPACE_LOGIN_IDLE_MINUTES=30
KQUANT_WORKSPACE_LOGIN_MAX_HOURS=8
KQUANT_GATEWAY_STOCKS_API_TOKEN=
KQUANT_GATEWAY_CRYPTO_API_TOKEN=

# Notifications are opt-in and disabled by default.
KQUANT_CRYPTO_ENABLE_NOTIFICATIONS=false
KQUANT_CRYPTO_ENABLE_TELEGRAM=false
KQUANT_CRYPTO_WEB_PUSH_PUBLIC_KEY=
KQUANT_CRYPTO_WEB_PUSH_PRIVATE_KEY=
KQUANT_CRYPTO_WEB_PUSH_SUBJECT=mailto:you@example.com
KQUANT_CRYPTO_TELEGRAM_BOT_TOKEN=
KQUANT_CRYPTO_TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
KQUANT_CRYPTO_VAPID_PUBLIC_KEY=
KQUANT_CRYPTO_VAPID_PRIVATE_KEY=
KQUANT_CRYPTO_VAPID_SUBJECT=mailto:local@kquant.invalid

# Binance execution is fail-closed. Keep disabled until historical OOS and
# Testnet gates pass. Testnet and Live must use separate trade-only API keys.
# Never grant withdrawal permission. Prefer an IP allowlist for Live.
KQUANT_CRYPTO_EXECUTION_MODE=disabled
KQUANT_CRYPTO_AUTOTRADE_ENABLED=false
KQUANT_CRYPTO_LIVE_CAPITAL_LIMIT=50
KQUANT_CRYPTO_RISK_PER_TRADE=0.01
KQUANT_CRYPTO_DAILY_LOSS_LIMIT=0.01
KQUANT_CRYPTO_TOTAL_OPEN_RISK_LIMIT=0.01
KQUANT_CRYPTO_MAX_LEVERAGE=2
KQUANT_CRYPTO_MAX_ENTRY_SLIPPAGE_BPS=20
KQUANT_CRYPTO_EXECUTION_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
