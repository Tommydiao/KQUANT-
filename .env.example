# Local only. Copy this file to .env and fill values on your machine.
# Do not paste API keys into chat, reports, screenshots, or committed files.

# Agent Harness MVP
# The harness does not need exchange credentials for dry-run or paper workflows.
APP_ENV=development
LIVE_TRADING_ENABLED=false
REQUIRE_APPROVAL_FOR_LIVE=true
MAX_ORDER_NOTIONAL=100
MAX_ASSET_EXPOSURE=0.10
MAX_DAILY_LOSS=50
AUDIT_LOG_ENABLED=true
PAPER_TRADING_ENABLED=true

# Alpaca Paper US Options
# Only used by explicit paper options endpoints. Do not commit real values.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# Binance USD-M Futures Testnet
BINANCE_FUTURES_TESTNET_API_KEY=
BINANCE_FUTURES_TESTNET_API_SECRET=

# Binance USD-M Futures Live
# Leave empty until Testnet sync and risk gates pass.
BINANCE_FUTURES_LIVE_API_KEY=
BINANCE_FUTURES_LIVE_API_SECRET=
