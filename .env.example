# Local only. Copy this file to .env and fill values on your machine.
# Do not paste API keys into chat, reports, screenshots, or committed files.

# KQUANT stock terminal / protected demo
# Keep OPENAI_API_KEY on the backend only. Never expose it through Vite env vars.
OPENAI_API_KEY=
KQUANT_AI_REVIEW_MODEL=gpt-5.4
KQUANT_AI_BATCH_MODEL=gpt-5.4-mini
KQUANT_AI_DEEP_MODEL=gpt-5.5
KQUANT_AI_RESEARCH_MODEL=gpt-5.5-pro

# Optional local email-and-password login. Run `python -m kquant local-login-config`
# to generate the local identity, password hash, and session secret for your private .env.
KQUANT_LOGIN_ENABLED=false
KQUANT_LOGIN_EMAIL=
KQUANT_LOGIN_PASSWORD_HASH=
KQUANT_SESSION_SECRET=
KQUANT_LOGIN_IDLE_MINUTES=30
KQUANT_LOGIN_MAX_HOURS=8

# KQUANT uses Longbridge strictly for read-only market data. These stay local.
# Only quote and calendar credentials are used.
KQUANT_MARKET_DATA_PROVIDER=longbridge
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
KQUANT_LONGBRIDGE_TIMEOUT_SECONDS=12

# Deterministic realtime instruction supervisor. This emits manual-review alerts only.
KQUANT_REALTIME_SUPERVISOR_ENABLED=true
KQUANT_REALTIME_SUPERVISOR_INTERVAL_SECONDS=15
KQUANT_REALTIME_MAX_CANDIDATES=30

# Optional personal alert delivery. Web SSE works without Telegram.
KQUANT_ENABLE_NOTIFICATIONS=false
KQUANT_TELEGRAM_BOT_TOKEN=
KQUANT_TELEGRAM_CHAT_ID=

# Optional iPhone Home Screen Web Push. Generate a VAPID key pair locally;
# never commit the private key or paste it into screenshots.
KQUANT_WEB_PUSH_ENABLED=false
KQUANT_WEB_PUSH_PUBLIC_KEY=
KQUANT_WEB_PUSH_PRIVATE_KEY=
KQUANT_WEB_PUSH_SUBJECT=mailto:local@kquant.invalid

# Cloudflare Access protected backend for Vercel frontend.
# Example: KQUANT_CLOUDFLARE_HOSTNAME=kquant-api.example.com
KQUANT_CLOUDFLARE_HOSTNAME=
KQUANT_CLOUDFLARE_TUNNEL_NAME=

# Vercel frontend build-time env. This is a public frontend URL, not a secret.
# Example: VITE_KQUANT_API_BASE_URL=https://kquant-api.example.com
VITE_KQUANT_API_BASE_URL=

# KQUANT has no execution configuration. Do not add execution credentials here.
