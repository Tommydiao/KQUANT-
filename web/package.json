{
  "name": "kquant-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:unified": "tsc -p tsconfig.unified.json && vite build --config vite.unified.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.165.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4"
  }
}
